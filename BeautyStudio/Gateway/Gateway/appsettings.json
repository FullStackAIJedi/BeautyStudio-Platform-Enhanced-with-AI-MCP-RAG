{
  "Jwt": {
    "Issuer": "https://identity-api",
    "Audience": "salon-client",
    "Secret": ""
  },
  "ReverseProxy": {
    "Routes": {
      "identity-public": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "AuthorizationPolicy": "anonymous"
      },
      "salon-public-services": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/services/public" },
        "AuthorizationPolicy": "anonymous"
      },
      "salon-public-employees": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/employees/public" },
        "AuthorizationPolicy": "anonymous"
      },
      "salon-public-portfolio": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/portfolio/public" },
        "AuthorizationPolicy": "anonymous"
      },
      "salon-public-locations": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/locations/public" },
        "AuthorizationPolicy": "anonymous"
      },
      "salon-public-categories": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/categories" },
        "AuthorizationPolicy": "anonymous"
      },
      "salon-services": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/services/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "salon-categories": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/categories/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "salon-clients": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/clients/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "salon-locations": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/locations/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "salon-portfolio": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/portfolio/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "salon-appointments": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/appointments/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "salon-employees": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/employees/{**catch-all}" },
        "AuthorizationPolicy": "Employee"
      },
      "salon-admin": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/api/salon/admin/{**catch-all}" },
        "AuthorizationPolicy": "Management"
      },
      "shop-public-products": {
        "ClusterId": "shop-cluster",
        "Match": { "Path": "/api/shop/products/public" },
        "AuthorizationPolicy": "anonymous"
      },
      "shop-products": {
        "ClusterId": "shop-cluster",
        "Match": { "Path": "/api/shop/products/{**catch-all}" },
        "AuthorizationPolicy": "Management"
      },
      "shop-cart": {
        "ClusterId": "shop-cluster",
        "Match": { "Path": "/api/shop/cart/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "shop-payments": {
        "ClusterId": "shop-cluster",
        "Match": { "Path": "/api/shop/payments/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      },
      "salon-hubs": {
        "ClusterId": "salon-cluster",
        "Match": { "Path": "/hubs/{**catch-all}" },
        "AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "primary": { "Address": "http://identity-api:8080/" }
        }
      },
      "salon-cluster": {
        "Destinations": {
          "primary": { "Address": "http://salon-api:8080/" }
        }
      },
      "shop-cluster": {
        "Destinations": {
          "primary": { "Address": "http://shop-api:8080/" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}